# ==============================================================================
# Disaster Response Coordination Hub (DRCH) - Environment Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL / Neon)
# ------------------------------------------------------------------------------
# Credentials used by local postgres container:
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=drch_db

# Unified connection URI (Used by backend & ai-workers):
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5432/${POSTGRES_DB}

# ------------------------------------------------------------------------------
# 2. Cache & Message Broker (Redis & RabbitMQ / CloudAMQP)
# ------------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0

RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_URL=amqp://${RABBITMQ_USER}:${RABBITMQ_PASS}@localhost:5672/

# ------------------------------------------------------------------------------
# 3. Application Security & Microservices
# ------------------------------------------------------------------------------
JWT_SECRET=supersecretkey_change_in_production_32chars_min

# Encrypts staff TOTP (MFA) secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=

# Minutes before an unacknowledged dispatch escalates to supervisors (DM-NFR-13).
DISPATCH_ACK_TIMEOUT_MINUTES=15

# Optional external AI triage service (advisory only). Leave empty when none is available.
AI_TRIAGE_URL=

# Frontend server-side URL of the backend API (used by the Next.js server, never the browser).
API_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# 4. AI Provider API Keys
# ------------------------------------------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_key_here
